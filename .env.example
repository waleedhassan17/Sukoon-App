# Quran Voice Assistant — Gemini key (read at build time, never committed).
# Get a key at https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# Emotion-detection API base URL (optional). Defaults to the hosted Hugging Face
# Space; set it to point a build at a staging or self-hosted instance.
# EXPO_PUBLIC_EMOTION_API_URL=https://your-emotion-api.example.com
