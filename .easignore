# ===== EAS Build Ignore =====
# Exclude files not needed for cloud builds to speed up uploads

# Dependencies (EAS runs npm install on the server)
node_modules/

# Expo cache
.expo/

# Native build outputs (EAS rebuilds from scratch)
android/app/build/
android/build/
android/.gradle/
ios/build/
ios/Pods/

# Pre-built AAB/APK artifacts
*.aab
*.apk

# Keystore files (EAS uses managed credentials)
*.jks
*.keystore

# iOS signing
*.p8
*.p12
*.key
*.mobileprovision

# Google service account (not needed for build)
google-service-account.json

# Environment files
.env
.env.local

# Git
.git/

# IDE / Editor
.vscode/
.idea/

# macOS
.DS_Store
*.orig.*

# Build scripts (not needed in cloud)
build-apk.sh
build-debug.sh
build-release.sh

# Documentation (not needed for build)
*.md

# TypeScript build info
*.tsbuildinfo

# Test coverage
coverage/

# Web build output — `expo export` writes here. Never needed for a native build,
# and it was ~33 MB of the upload tarball (a stale web bundle plus a duplicated
# 11 MB font), which is what tipped the upload over into a 408 timeout.
web-build/
dist/

# Firebase backend and tests. These live inside the app directory so they are
# version-controlled next to the client they secure, but they are never part of
# the app bundle — Metro blocklists them and tsconfig excludes them, so there is
# no reason to ship them to the build server either.
functions/
tests/
__tests__/
firestore.rules
firestore.indexes.json
firebase.json
.firebaserc
emulator-data/
firestore-debug.log
firebase-debug.log

# Repo tooling
tools/
